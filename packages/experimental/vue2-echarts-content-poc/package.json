{
  "name": "@deepseek-ai/dsh-experimental-vue2-echarts-content-poc",
  "description": "Placement plugin: puts the Vue 2.7 ECharts panel in the service-line shell's content column",
  "version": "0.1.1-rc.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/vue2-echarts-content-poc"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "external": [
        "@deepseek-ai/dsh-experimental-vue2-echarts-poc/client"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-experimental-server-layout",
        "@deepseek-ai/dsh-experimental-vue2-echarts-poc"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-client-runtime": "workspace:^",
    "@deepseek-ai/dsh-experimental-server-layout": "workspace:^",
    "@deepseek-ai/dsh-experimental-vue2-echarts-poc": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-client-runtime": "workspace:^",
    "@deepseek-ai/dsh-experimental-server-layout": "workspace:^",
    "@deepseek-ai/dsh-experimental-vue2-echarts-poc": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
