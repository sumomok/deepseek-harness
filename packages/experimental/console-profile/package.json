{
  "name": "@deepseek-ai/dsh-experimental-console-profile",
  "description": "Private bundle that composes the customer console over the Web profile: the service shell, the product sidebar, and the rows that keep internal vocabulary and developer surfaces off a customer page",
  "version": "0.1.7-rc.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/console-profile"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./permission-lock.patch.yml": "./permission-lock.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "permission-lock.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-experimental-content-column": "workspace:*",
    "@deepseek-ai/dsh-experimental-content-surface": "workspace:*",
    "@deepseek-ai/dsh-experimental-library-skills": "workspace:*",
    "@deepseek-ai/dsh-experimental-server-layout": "workspace:*",
    "@deepseek-ai/dsh-experimental-server-sidebar": "workspace:*",
    "@deepseek-ai/dsh-skill-filesystem": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-package-manifest": "workspace:*",
    "js-yaml": "^4.2.0"
  }
}
