              "kind": "boolean"
            }
          },
          "pageSize": {
            "summary": "number",
            "required": false,
            "viewOnly": true,
            "unbindable": true,
            "schema": {
              "kind": "number",
              "min": 1,
              "max": 1000,
              "integer": true
            }
          },
          "pageSizes": {
            "summary": "[number] (1–10)",
            "required": false,
