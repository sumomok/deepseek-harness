                  "op": {
                    "summary": "EQ|NOT_EQ|IN|NOT_IN|LIKE|NOT_LIKE|IS_NULL|NOT_NULL|PREFIX|NOT_PREFIX|GREATER_THAN|EQ_AND_GREATER_THAN|LESS_THAN|LESS_AND_EQ_THAN|BETWEEN|NOT_BETWEEN",
                    "required": true,
                    "schema": {
                      "kind": "enum",
                      "values": [
                        "EQ",
                        "NOT_EQ",
                        "IN",
                        "NOT_IN",
                        "LIKE",
                        "NOT_LIKE",
                        "IS_NULL",
                        "NOT_NULL",
                        "PREFIX",
                        "NOT_PREFIX",
                        "GREATER_THAN",
                        "EQ_AND_GREATER_THAN",
                        "LESS_THAN",
                        "LESS_AND_EQ_THAN",
                        "BETWEEN",
