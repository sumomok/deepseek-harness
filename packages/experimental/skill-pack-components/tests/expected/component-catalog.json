                    "kind": "boolean"
                  }
                },
                "addForm": {
                  "summary": "true|false",
                  "required": false,
                  "schema": {
                    "kind": "boolean"
                  }
                },
                "modifyForm": {
                  "summary": "true|false",
                  "required": false,
                  "schema": {
                    "kind": "boolean"
                  }
                }
              }
            }
          },
          "toolbarButtons": {
            "summary": "[add|exp|gridexp|search|clear] (0–5)",
            "required": false,
            "viewOnly": true,
            "unbindable": true,
            "schema": {
              "kind": "array",
              "item": {
                "kind": "enum",
                "values": [
                  "add",
                  "exp",
                  "gridexp",
                  "search",
                  "clear"
                ],
                "hint": "This page draws no import panel and no batch panel, so \"imp\" and \"batch\" are not on the list: either button would draw and answer nothing when it was pressed."
              },
              "minItems": 0,
              "maxItems": 5
            }
          },
          "rowOperations": {
            "summary": "[modify] (0–1)",
            "required": false,
            "viewOnly": true,
            "unbindable": true,
            "schema": {
              "kind": "array",
              "item": {
                "kind": "enum",
                "values": [
                  "modify"
                ],
                "hint": "This page draws no delete confirmation, so \"delete\" is not on the list: the button would draw and answer nothing when it was pressed."
              },
              "minItems": 0,
              "maxItems": 1
            }
          },
          "queryExpanded": {
            "summary": "true|false",
            "required": false,
            "viewOnly": true,
            "unbindable": true,
