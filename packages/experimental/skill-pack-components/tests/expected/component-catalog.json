      {
        "id": "el.confirm-bar",
        "label": "确认条",
        "purpose": "A short prompt above a row of buttons, for putting one decision in front of the user.",
        "placement": "call",
        "deploymentSwitches": [],
        "props": {
          "title": {
            "summary": "text",
            "required": false,
            "viewOnly": false,
            "unbindable": false,
            "schema": {
              "kind": "string",
              "maxLength": 80
            }
          },
          "message": {
            "summary": "text",
            "required": false,
            "viewOnly": false,
            "unbindable": false,
            "schema": {
              "kind": "string",
              "maxLength": 400
            }
          },
          "buttons": {
            "summary": "[{id, label, tone? (primary|default|danger)}] (1–5)",
            "required": true,
            "viewOnly": false,
            "unbindable": false,
            "schema": {
              "kind": "array",
              "item": {
                "kind": "object",
                "fields": {
                  "id": {
                    "summary": "text",
                    "required": true,
                    "schema": {
                      "kind": "string",
                      "maxLength": 32,
                      "charset": {
                        "pattern": "/^[\\w-]+$/",
                        "hint": "letters, digits, underscores and hyphens"
                      }
                    }
                  },
                  "label": {
                    "summary": "text",
                    "required": true,
                    "schema": {
                      "kind": "string",
                      "maxLength": 16
                    }
                  },
                  "tone": {
                    "summary": "primary|default|danger",
                    "required": false,
                    "schema": {
                      "kind": "enum",
                      "values": [
                        "primary",
                        "default",
                        "danger"
                      ]
                    }
                  }
                }
              },
              "minItems": 1,
              "maxItems": 5,
              "uniqueBy": "id"
            }
          }
        },
        "outputs": [],
        "actions": [
          {
            "id": "press",
            "report": "wake"
          }
        ]
      },
