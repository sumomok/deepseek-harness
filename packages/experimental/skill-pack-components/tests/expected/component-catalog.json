                      "charset": {
                        "pattern": "/^[A-Za-z_][\\w-]*$/",
                        "hint": "a letter or an underscore, then letters, digits, underscores and hyphens"
                      }
                    }
                  },
                  "label": {
                    "summary": "text",
                    "required": true,
                    "schema": {
                      "kind": "string",
                      "maxLength": 64
                    }
                  }
                }
              },
              "minItems": 1,
              "maxItems": 5
            }
          },
          "regions": {
            "summary": "{query? (true|false), toolbar? (true|false), table? (true|false), operate? (true|false), pagination? (true|false), infoCard? (true|false), addForm? (true|false), modifyForm? (true|false)}",
            "required": false,
            "viewOnly": true,
            "unbindable": true,
            "schema": {
              "kind": "object",
              "fields": {
                "query": {
                  "summary": "true|false",
                  "required": false,
                  "schema": {
                    "kind": "boolean"
                  }
                },
                "toolbar": {
                  "summary": "true|false",
                  "required": false,
                  "schema": {
