            "summary": "text",
            "required": true,
            "viewOnly": false,
            "unbindable": true,
            "schema": {
              "kind": "string",
              "maxLength": 20,
              "charset": {
                "pattern": "/^[^\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}「」]+$/u",
                "hint": "one line of plain text, carrying no line break, no other control character, and no 「」 bracket"
              }
            }
          },
          "conditions": {
            "summary": "[{key, op (EQ|NOT_EQ|IN|NOT_IN|LIKE|NOT_LIKE|IS_NULL|NOT_NULL|PREFIX|NOT_PREFIX|GREATER_THAN|EQ_AND_GREATER_THAN|LESS_THAN|LESS_AND_EQ_THAN|BETWEEN|NOT_BETWEEN), value (text|number|true|false|[text|number])}] (1–10)",
