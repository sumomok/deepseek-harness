.cache/
# build/ is electron-builder's buildResources directory: it holds generated
# icons AND hand-written installer sources, so only the generated members are
# ignored. installer.nsh is source and must be tracked — a build that silently
# loses it produces an installer without the customCheckAppRunning and
# customFinishPage hooks.
build/icon.icns
build/icon.ico
build/icon.iconset/
dist-app/
staging/
# Signing material belongs outside the checkout — scripts/sign-mac.cjs reads it
# from ~/Library/Application Support/dsh-desktop-signing by default. These
# patterns are the backstop for a copy landing here anyway: a private key in
# git history cannot be taken back, and this one anchors the designated
# requirement every installed build validates against.
*.p12
*.pfx
*.key
*.pem
*.keychain
*.keychain-db
*.pass
